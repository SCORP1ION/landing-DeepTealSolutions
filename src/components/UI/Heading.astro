---
import styles from "../../styles/components/heading.module.css";
import Hexagon from "../icons/Hexagon.astro";
import GetStarted from "./GetStarted.astro";
---

<header class={styles.header}>
  <div class={styles.left}>
    <Hexagon />
    <a class={styles.marca}>Deep Teal</a>
  </div>

  <nav class={styles.nav}>
    <div class={styles.navLinks}>
      <span>Service</span>
      <span>Process</span>
      <span>Testimonials</span>
      <span>About</span>
    </div>
    <div class={styles.right}>
      <GetStarted />
    </div>
  </nav>

  {/* Botón hamburguesa */}
  <button class={styles.menuBtn} aria-label="Open menu"> ☰ </button>
</header>
